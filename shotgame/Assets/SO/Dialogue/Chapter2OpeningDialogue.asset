%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4626535ac33ff934280728c50096b119, type: 3}
  m_Name: Chapter2OpeningDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  partnerPortrait: {fileID: 21300000, guid: 31eaf52e4ac948b2b83bba02852546a0, type: 3}
  dialogueLines:
  - speaker: 2
    characterName: 카이
    dialogueText: "광안리에 로봇들이 수상한 움직임을 하고있어"
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 카이
    dialogueText: "공장 밖으로 나가면 보트가 있을거다"
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 카이
    dialogueText: "보트를 타고 가면 되지만 조금만 가면 광안리로 가는 길이 막혀있어"
    characterImage: {fileID: 0}
  - speaker: 1
    characterName: 아리사
    dialogueText: "거기에 혹시 뭐가 있는거지?"
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 카이
    dialogueText: "미확인 로봇이 바다를 점령한거 같에"
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 카이
    dialogueText: "이 로봇을 처치하고 광안리로 갈 수 있도록"
    characterImage: {fileID: 0}
  - speaker: 1
    characterName: 아리사
    dialogueText: "하... 살아갈수있겠지"
    characterImage: {fileID: 0}
