%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4626535ac33ff934280728c50096b119, type: 3}
  m_Name: GongOilIntro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  partnerPortrait: {fileID: 21300000, guid: ed5d1ac6d5884992a0a8f8a2a9ae7d97, type: 3}
  dialogueLines:
  - speaker: 1
    characterName: 아리사
    dialogueText: "진짜였잖아?"
    voiceClip: {fileID: 8300000, guid: d7e5b47003833b243b5a03d1510ba8cd, type: 3}
    characterImage: {fileID: 0}
  - speaker: 1
    characterName: 아리사
    dialogueText: "중장님 왜 이런 반란을..."
    voiceClip: {fileID: 8300000, guid: 8b902bc61d9b7cf46a1d3668dfc5a7cd, type: 3}
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 공오일
    dialogueText: "너희 정규군은 썩은지 꽤 됐으니깐"
    voiceClip: {fileID: 8300000, guid: af3a4952a40d6e04f897071cba9b543b, type: 3}
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 공오일
    dialogueText: "내가 이제 로봇 시대가 올것이고"
    voiceClip: {fileID: 8300000, guid: c243f53162d30fc46be176905407bad2, type: 3}
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 공오일
    dialogueText: "10년동안 이 연구를 하고 논문까지 내고 로봇 공장까지 다 지었는데"
    voiceClip: {fileID: 8300000, guid: efbb1371e4f57f1439f11f580a625568, type: 3}
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 공오일
    dialogueText: "정규군 윗대가리들이 돈을 목적으로 나의 10년을 다 강탈해갔어"
    voiceClip: {fileID: 8300000, guid: 4547c339bb8592040803d500cec4915d, type: 3}
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 공오일
    dialogueText: "그러니깐....나는 썩은 군대를 정리하고 세계를 로봇으로 지배할거다"
    voiceClip: {fileID: 8300000, guid: 9a266e6c0b7df4d4eb54828017471f3c, type: 3}
    characterImage: {fileID: 0}
  - speaker: 1
    characterName: 아리사
    dialogueText: "제정신이 아니군... 앗 온다"
    voiceClip: {fileID: 8300000, guid: 3f38617a5a47bd04c982eb05393f93b5, type: 3}
    characterImage: {fileID: 0}
