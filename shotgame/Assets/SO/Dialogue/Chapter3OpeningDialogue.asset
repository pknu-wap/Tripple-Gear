MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4626535ac33ff934280728c50096b119, type: 3}
  m_Name: Chapter3OpeningDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  partnerPortrait: {fileID: 21300000, guid: 31eaf52e4ac948b2b83bba02852546a0, type: 3}
  dialogueLines:
  - speaker: 1
    characterName: 아리사
    dialogueText: "통신보안 소령 아리사, 광안리에 도착했다"
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 카이
    dialogueText: "통신보안 중령 카이, 장산으로 가면 비행선이 하나있어"
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 카이
    dialogueText: "거기에 은퇴한 전 중장 공오일이 있다고 해"
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 카이
    dialogueText: "이번 로봇 반란은 그가 발생시킨걸로 보여"
    characterImage: {fileID: 0}
  - speaker: 2
    characterName: 카이
    dialogueText: "가서 처치하도록"
    characterImage: {fileID: 0}
